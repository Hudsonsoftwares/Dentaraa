<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_appointment_type_tree" model="ir.ui.view">
        <field name="name">dental.appointment.type.tree</field>
        <field name="model">dental.appointment.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_dental_appointment_type" model="ir.actions.act_window">
        <field name="name">Appointment Types</field>
        <field name="res_model">dental.appointment.type</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
