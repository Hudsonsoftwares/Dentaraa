<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_dental_appointment" model="ir.ui.view">
        <field name="name">res.partner.form.dental.appointment</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_appointments" type="object" class="oe_stat_button" icon="fa-calendar" invisible="not is_dental_patient">
                    <field name="appointment_count" widget="statinfo" string="Appointments"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
