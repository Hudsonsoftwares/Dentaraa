<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Appointments Top Menu -->
    <menuitem id="menu_dental_appointment_root"
              name="Appointments"
              parent="dental_base.menu_dental_root"
              sequence="30"
              groups="dental_base.group_dental_receptionist,dental_base.group_dental_dentist,dental_base.group_dental_manager,dental_base.group_dental_admin,dental_base.group_dental_assistant"/>

    <!-- Today's Appointments -->
    <record id="action_dental_appointment_today" model="ir.actions.act_window">
        <field name="name">Today's Appointments</field>
        <field name="res_model">dental.appointment</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="domain">[('date_start', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('date_start', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]</field>
    </record>
    <menuitem id="menu_reception_todays_appointments"
              name="Today's Appointments"
              parent="menu_dental_appointment_root"
              action="action_dental_appointment_today"
              sequence="10"
              groups="dental_base.group_dental_receptionist,dental_base.group_dental_dentist,dental_base.group_dental_manager,dental_base.group_dental_admin,dental_base.group_dental_assistant"/>

    <!-- All Appointments -->
    <menuitem id="menu_dental_appointment"
              name="All Appointments"
              parent="menu_dental_appointment_root"
              action="action_dental_appointment"
              sequence="20"
              groups="dental_base.group_dental_receptionist,dental_base.group_dental_dentist,dental_base.group_dental_manager,dental_base.group_dental_admin,dental_base.group_dental_assistant"/>
    
    <!-- Unified Calendar -->
    <record id="action_dental_appointment_calendar" model="ir.actions.act_window">
        <field name="name">Calendar</field>
        <field name="res_model">dental.appointment</field>
        <field name="view_mode">calendar,list,form</field>
    </record>
    <menuitem id="menu_dental_appointment_calendar"
              name="Calendar"
              parent="menu_dental_appointment_root"
              action="action_dental_appointment_calendar"
              sequence="30"
              groups="dental_base.group_dental_receptionist,dental_base.group_dental_dentist,dental_base.group_dental_manager,dental_base.group_dental_admin,dental_base.group_dental_assistant"/>

    <!-- Waiting Queue (Consolidated clinic-wide waiting list) -->
    <menuitem id="menu_dentist_queue"
              name="Waiting Queue"
              parent="menu_dental_appointment_root"
              action="action_dental_appointment_queue"
              sequence="40"
              groups="dental_base.group_dental_receptionist,dental_base.group_dental_dentist,dental_base.group_dental_manager,dental_base.group_dental_admin,dental_base.group_dental_assistant"/>

    <!-- RETIRED DUPLICATES: Kept inactive to preserve XML IDs and avoid database orphans -->
    <!-- 1. Duplicate My Appointments (Already under My Workspace) -->
    <record id="menu_dentist_my_appointments_main" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- 2. Duplicate Calendar entry -->
    <record id="menu_dentist_calendar" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- 3. Obsolete top-level Check-in & Queue parent (items organized under Reception Desk) -->
    <record id="menu_dental_queue_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- 4. Obsolete top-level Follow-ups & Recalls parent (items organized under Reception Desk) -->
    <record id="menu_dental_followup_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- 5. Obsolete intermediate Appointment Configuration parent -->
    <record id="menu_dental_appointment_config" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Actions for Check-in & Queue and Follow-ups reused in Reception Desk -->
    <record id="action_dental_patient_checkin" model="ir.actions.act_window">
        <field name="name">Patient Check-in</field>
        <field name="res_model">dental.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'confirmed'), ('date_start', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('date_start', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]</field>
    </record>

    <!-- Configuration Menus under Master Configuration -->
    <menuitem id="menu_dental_appointment_type"
              name="Appointment Types"
              parent="dental_base.menu_dental_configuration"
              action="action_dental_appointment_type"
              sequence="40"
              groups="dental_base.group_dental_admin"/>

    <menuitem id="menu_dental_recall_rule"
              name="Recall Rules"
              parent="dental_base.menu_dental_configuration"
              action="action_dental_recall_rule"
              sequence="50"
              groups="dental_base.group_dental_admin"/>
</odoo>
