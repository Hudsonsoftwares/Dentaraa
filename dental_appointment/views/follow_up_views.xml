<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_follow_up_tree" model="ir.ui.view">
        <field name="name">dental.follow_up.tree</field>
        <field name="model">dental.follow.up</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'pending'" decoration-success="state == 'done'" decoration-danger="state == 'cancelled'">
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="treatment_id"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_dental_follow_up_form" model="ir.ui.view">
        <field name="name">dental.follow_up.form</field>
        <field name="model">dental.follow.up</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" string="Done" type="object" class="oe_highlight" invisible="state != 'pending'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="appointment_id"/>
                            <field name="doctor_id"/>
                            <field name="treatment_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dental_follow_up" model="ir.actions.act_window">
        <field name="name">Follow-ups</field>
        <field name="res_model">dental.follow.up</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
