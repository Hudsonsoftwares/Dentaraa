<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Appointment Confirmation Template -->
        <record id="email_template_appointment_confirmation" model="mail.template">
            <field name="name">Dental Appointment: Confirmation</field>
            <field name="model_id" ref="model_dental_appointment"/>
            <field name="subject">Appointment Confirmation: {{ object.name }}</field>
            <field name="email_to">{{ object.patient_id.email_formatted }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, Helvetica, sans-serif;">
    <div style="max-width: 600px; margin: 0 auto; border: 1px solid #e1e1e1; border-radius: 5px; overflow: hidden;">
        <div style="background-color: #4CAF50; padding: 20px; text-align: center; color: white;">
            <h2 style="margin: 0;">Appointment Confirmed</h2>
        </div>
        <div style="padding: 20px; color: #333333; font-size: 14px; line-height: 1.5;">
            <p>Dear <strong><t t-out="object.patient_id.name or 'Patient'"/></strong>,</p>
            <p>We are pleased to confirm your upcoming dental appointment.</p>
            
            <div style="background-color: #f9f9f9; padding: 15px; border-radius: 5px; margin-top: 20px; margin-bottom: 20px;">
                <h4 style="margin-top: 0; color: #4CAF50; border-bottom: 1px solid #ddd; padding-bottom: 10px;">Appointment Details</h4>
                <table style="width: 100%; font-size: 14px;">
                    <tr><td style="padding: 5px 0; width: 40%;"><strong>Reference:</strong></td><td style="padding: 5px 0;"><t t-out="object.name or ''"/></td></tr>
                    <tr><td style="padding: 5px 0;"><strong>Date &amp; Time:</strong></td><td style="padding: 5px 0;"><t t-out="format_datetime(object.date_start, tz=object.env.user.tz)"/></td></tr>
                    <tr><td style="padding: 5px 0;"><strong>Dentist:</strong></td><td style="padding: 5px 0;">Dr. <t t-out="object.doctor_id.name or ''"/></td></tr>
                    <tr><td style="padding: 5px 0;"><strong>Visit Type:</strong></td><td style="padding: 5px 0;"><t t-out="object.appointment_type_id.name or object.treatment_id.name or 'Consultation'"/></td></tr>
                    <tr><td style="padding: 5px 0;"><strong>Clinic/Branch:</strong></td><td style="padding: 5px 0;"><t t-out="object.branch_id.name or 'Main Clinic'"/></td></tr>
                </table>
            </div>
            
            <p>Please arrive 10 minutes prior to your scheduled time. If you need to reschedule, please contact us at your earliest convenience.</p>
            <p>Best regards,<br/>
            <strong><t t-out="object.branch_id.name or 'Our Dental Clinic'"/></strong></p>
        </div>
    </div>
</div>
            </field>
        </record>
        
        <!-- Appointment Reminder Template -->
        <record id="email_template_appointment_reminder" model="mail.template">
            <field name="name">Dental Appointment: Reminder</field>
            <field name="model_id" ref="model_dental_appointment"/>
            <field name="subject">Appointment Reminder: {{ object.name }}</field>
            <field name="email_to">{{ object.patient_id.email_formatted }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear <t t-out="object.patient_id.name or ''"/>,<br/><br/>
        This is a reminder for your upcoming appointment.<br/><br/>
        <strong>Appointment Details:</strong><br/>
        Date: <t t-out="object.date_start or ''"/><br/>
        Doctor: <t t-out="object.doctor_id.name or ''"/><br/>
        <br/>
        Please arrive on time. Thank you!
    </p>
</div>
            </field>
        </record>
    </data>
</odoo>
