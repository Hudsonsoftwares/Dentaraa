<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dental_appointment" model="ir.sequence">
            <field name="name">Dental Appointment</field>
            <field name="code">dental.appointment</field>
            <field name="prefix">APT/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_dental_queue_token" model="ir.sequence">
            <field name="name">Dental Queue Token</field>
            <field name="code">dental.queue.token</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
