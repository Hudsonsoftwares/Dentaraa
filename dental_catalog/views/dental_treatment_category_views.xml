<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_dental_treatment_category_tree" model="ir.ui.view">
        <field name="name">dental.treatment.category.tree</field>
        <field name="model">dental.treatment.category</field>
        <field name="arch" type="xml">
            <list string="Treatment Categories">
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_dental_treatment_category_form" model="ir.ui.view">
        <field name="name">dental.treatment.category.form</field>
        <field name="model">dental.treatment.category</field>
        <field name="arch" type="xml">
            <form string="Treatment Category">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == False"/>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_dental_treatment_category" model="ir.actions.act_window">
        <field name="name">Treatment Categories</field>
        <field name="res_model">dental.treatment.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Dental Treatment Category
            </p>
        </field>
    </record>
</odoo>
