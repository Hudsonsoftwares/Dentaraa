<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Deactivate obsolete top-level Treatments parent to keep main navbar clean and compact -->
    <record id="menu_dental_treatments_main" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Treatment Catalog placed cleanly under Configuration -->
    <menuitem
        id="menu_dental_treatments"
        name="Treatment Catalog"
        parent="dental_base.menu_dental_configuration"
        action="action_dental_treatments"
        sequence="70"
        groups="dental_base.group_dental_manager,dental_base.group_dental_admin"/>

    <!-- Treatment Categories placed cleanly under Configuration -->
    <menuitem
        id="menu_dental_treatment_categories"
        name="Treatment Categories"
        parent="dental_base.menu_dental_configuration"
        action="action_dental_treatment_category"
        sequence="75"
        groups="dental_base.group_dental_manager,dental_base.group_dental_admin"/>
</odoo>
