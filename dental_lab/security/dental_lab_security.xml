<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lab Groups under Dental Category -->
    <record id="group_dental_lab_user" model="res.groups">
        <field name="name">Lab Technician / User</field>
        <field name="privilege_id" ref="dental_base.res_groups_privilege_dental"/>
        <field name="implied_ids" eval="[(4, ref('dental_base.group_dental_lab_technician')), (4, ref('base.group_user'))]"/>
        <field name="comment">Technicians handling prosthetics fabrication, model casting, milling, and dental restorations.</field>
    </record>

    <record id="group_dental_lab_manager" model="res.groups">
        <field name="name">Lab Administrator / Coordinator</field>
        <field name="privilege_id" ref="dental_base.res_groups_privilege_dental"/>
        <field name="implied_ids" eval="[(4, ref('dental_lab.group_dental_lab_user')), (4, ref('Quality.group_quality_user')), (4, ref('mrp.group_mrp_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Dental Laboratory Manager / Coordinator responsible for production scheduling, QC review, technician assignment, and external lab routing.</field>
    </record>

    <!-- Connect Dental Admin to Lab Manager -->
    <record id="dental_base.group_dental_admin" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('dental_lab.group_dental_lab_manager'))]"/>
    </record>

    <!-- Connect Dental Lab Technician to Lab User -->
    <record id="dental_base.group_dental_lab_technician" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('dental_lab.group_dental_lab_user'))]"/>
    </record>
</odoo>
