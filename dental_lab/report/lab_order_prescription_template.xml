<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_lab_order_prescription_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: sans-serif; font-size: 13px;">
                        <div class="row pb-3 mb-3 border-bottom">
                            <div class="col-7">
                                <h3 class="text-primary mb-1 fw-bold">Dental Laboratory Work Order</h3>
                                <div class="text-muted small">Clinical Prescription &amp; Technical Specifications</div>
                            </div>
                            <div class="col-5 text-end">
                                <h4 class="mb-0 text-dark"><span t-field="doc.name"/></h4>
                                <div class="badge bg-secondary">
                                    <span t-if="doc.lab_type == 'in_house'">In-House Laboratory</span>
                                    <span t-else="">External Commercial Lab</span>
                                </div>
                            </div>
                        </div>

                        <!-- Info Header -->
                        <div class="row g-2 mb-3 p-2 bg-light rounded border">
                            <div class="col-6">
                                <div><strong>Patient Name:</strong> <span t-field="doc.patient_id.name"/></div>
                                <div><strong>Patient Age / Gender:</strong> <span t-field="doc.patient_age"/> yrs / <span t-field="doc.patient_gender"/></div>
                                <div><strong>Dental Case #:</strong> <span t-field="doc.case_id.name"/></div>
                                <div><strong>Prescribing Dentist:</strong> <span t-field="doc.dentist_id.name"/></div>
                            </div>
                            <div class="col-6">
                                <div><strong>Order Date:</strong> <span t-field="doc.order_date"/></div>
                                <div><strong>Required Delivery:</strong> <strong class="text-danger"><span t-field="doc.due_date"/></strong></div>
                                <div><strong>Assigned Technician:</strong> <span t-field="doc.technician_id.name"/></div>
                                <div><strong>Priority:</strong> <span t-field="doc.priority"/></div>
                            </div>
                        </div>

                        <!-- Technical Specs -->
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="card h-100 p-2 border">
                                    <h6 class="fw-bold text-secondary border-bottom pb-1">Impression Specifications</h6>
                                    <div><strong>Impression Format:</strong> <span t-field="doc.impression_type"/></div>
                                    <div><strong>Antagonist Arch:</strong> <span t-if="doc.antagonist_impression">Yes</span><span t-else="">No</span></div>
                                    <div><strong>Bite Registration:</strong> <span t-if="doc.bite_registration">Yes</span><span t-else="">No</span></div>
                                    <div><strong>Articulator:</strong> <span t-if="doc.articulators_included">Included</span><span t-else="">None</span></div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="card h-100 p-2 border">
                                    <h6 class="fw-bold text-secondary border-bottom pb-1">Esthetics &amp; Preparation</h6>
                                    <div><strong>Target VITA Shade:</strong> <strong class="text-primary"><span t-field="doc.shade"/></strong></div>
                                    <div><strong>Stump Die Shade:</strong> <span t-field="doc.stump_shade"/></div>
                                    <div><strong>Margin Design:</strong> <span t-field="doc.margin_design"/></div>
                                    <div><strong>Occlusal Clearance:</strong> <span t-field="doc.occlusal_clearance"/></div>
                                </div>
                            </div>
                        </div>

                        <!-- Tooth Restorations Table -->
                        <h6 class="fw-bold text-dark mt-3 mb-2">Prescribed Tooth Restorations</h6>
                        <table class="table table-bordered table-sm mb-3">
                            <thead class="table-secondary">
                                <tr>
                                    <th style="width: 15%;">FDI Tooth</th>
                                    <th style="width: 25%;">Restoration Type</th>
                                    <th style="width: 25%;">Material</th>
                                    <th style="width: 15%;">Shade</th>
                                    <th style="width: 10%;">Qty</th>
                                    <th style="width: 10%;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td class="fw-bold text-primary"><span t-field="line.tooth_number"/></td>
                                    <td><span t-field="line.restoration_type"/></td>
                                    <td><span t-field="line.material"/></td>
                                    <td><span t-field="line.shade"/></td>
                                    <td><span t-field="line.quantity"/></td>
                                    <td><span t-field="line.state"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Clinical Instructions -->
                        <div class="mb-3 p-2 border rounded" t-if="doc.clinical_instructions">
                            <strong>Prescription Instructions:</strong>
                            <div class="text-muted mt-1"><span t-field="doc.clinical_instructions"/></div>
                        </div>

                        <!-- Quality & Signatures -->
                        <div class="row mt-4 pt-3 border-top">
                            <div class="col-4 text-center">
                                <div style="height: 40px;"/>
                                <div class="border-top pt-1"><strong>Prescribing Dentist</strong></div>
                            </div>
                            <div class="col-4 text-center">
                                <div style="height: 40px;"/>
                                <div class="border-top pt-1"><strong>Lab Technician / CAD</strong></div>
                            </div>
                            <div class="col-4 text-center">
                                <div style="height: 40px;"/>
                                <div class="border-top pt-1"><strong>Quality Control Inspector</strong></div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
