<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_lab_dispatch_form" model="ir.ui.view">
        <field name="name">dental.lab.dispatch.form</field>
        <field name="model">dental.lab.dispatch</field>
        <field name="arch" type="xml">
            <form string="Laboratory Dispatch Delivery">
                <header>
                    <button name="action_mark_delivered" string="Mark Delivered to Clinic" type="object"
                            class="btn-primary" invisible="state != 'in_transit'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_transit,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Dispatch Record</span>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Order &amp; Patient">
                            <field name="order_id" readonly="state != 'draft'"/>
                            <field name="patient_id"/>
                            <field name="destination_clinic_id"/>
                        </group>
                        <group string="Logistics &amp; Courier">
                            <field name="dispatch_date"/>
                            <field name="sender_id"/>
                            <field name="delivery_method"/>
                            <field name="courier_name" invisible="delivery_method != 'courier'"/>
                            <field name="tracking_reference" invisible="delivery_method != 'courier'"/>
                        </group>
                    </group>
                    <group string="Dispatch &amp; Handling Notes">
                        <field name="notes" nolabel="1" placeholder="Fragile, handle with care, model included..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dental_lab_dispatch_list" model="ir.ui.view">
        <field name="name">dental.lab.dispatch.list</field>
        <field name="model">dental.lab.dispatch</field>
        <field name="arch" type="xml">
            <list string="Laboratory Dispatches" decoration-info="state == 'in_transit'" decoration-success="state == 'delivered'">
                <field name="name"/>
                <field name="dispatch_date"/>
                <field name="order_id"/>
                <field name="patient_id"/>
                <field name="destination_clinic_id"/>
                <field name="delivery_method"/>
                <field name="sender_id"/>
                <field name="state" widget="badge" decoration-info="state == 'in_transit'" decoration-success="state == 'delivered'"/>
            </list>
        </field>
    </record>

    <record id="action_dental_lab_dispatches" model="ir.actions.act_window">
        <field name="name">Finished Goods Dispatches</field>
        <field name="res_model">dental.lab.dispatch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
