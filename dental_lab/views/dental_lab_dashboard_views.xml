<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_lab_dashboard_form" model="ir.ui.view">
        <field name="name">dental.lab.dashboard.form</field>
        <field name="model">dental.lab.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dental Laboratory Dashboard" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title mb-3">
                        <h2>Dental Laboratory Operations &amp; Quality Intelligence</h2>
                        <span class="text-muted">Real-time status across in-house production, quality checks, dispatches, and external labs.</span>
                    </div>

                    <!-- Row 1: Primary Pipeline -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <div class="card border-primary shadow-sm h-100 p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted mb-1 text-uppercase fw-bold">Open Orders</h6>
                                        <h2 class="text-primary mb-0"><field name="total_open_orders"/></h2>
                                    </div>
                                    <div class="fs-1 text-primary opacity-50"><i class="fa fa-flask"/></div>
                                </div>
                                <div class="mt-3">
                                    <button name="action_view_open_orders" type="object" string="View All Open" class="btn btn-outline-primary btn-sm w-100"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="card border-info shadow-sm h-100 p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted mb-1 text-uppercase fw-bold">In Production</h6>
                                        <h2 class="text-info mb-0"><field name="in_production_count"/></h2>
                                    </div>
                                    <div class="fs-1 text-info opacity-50"><i class="fa fa-cogs"/></div>
                                </div>
                                <div class="mt-3">
                                    <button name="action_view_in_production" type="object" string="Active Manufacturing" class="btn btn-outline-info btn-sm w-100"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="card border-warning shadow-sm h-100 p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted mb-1 text-uppercase fw-bold">Awaiting QC</h6>
                                        <h2 class="text-warning mb-0"><field name="qc_pending_count"/></h2>
                                    </div>
                                    <div class="fs-1 text-warning opacity-50"><i class="fa fa-check-square-o"/></div>
                                </div>
                                <div class="mt-3">
                                    <button name="action_view_qc_pending" type="object" string="Inspect Queue" class="btn btn-outline-warning btn-sm w-100"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="card border-danger shadow-sm h-100 p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted mb-1 text-uppercase fw-bold">Rework Queue</h6>
                                        <h2 class="text-danger mb-0"><field name="rework_count"/></h2>
                                    </div>
                                    <div class="fs-1 text-danger opacity-50"><i class="fa fa-exclamation-triangle"/></div>
                                </div>
                                <div class="mt-3">
                                    <button name="action_view_rework" type="object" string="Review Defects" class="btn btn-outline-danger btn-sm w-100"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: Deliveries & Logistics -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <div class="card border-success shadow-sm h-100 p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted mb-1 text-uppercase fw-bold">Finished Ready</h6>
                                        <h2 class="text-success mb-0"><field name="finished_awaiting_dispatch"/></h2>
                                    </div>
                                    <div class="fs-1 text-success opacity-50"><i class="fa fa-cube"/></div>
                                </div>
                                <div class="mt-3 text-muted small">
                                    Passed Quality Control
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="card shadow-sm h-100 p-3 border-secondary">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted mb-1 text-uppercase fw-bold">In Transit to Clinic</h6>
                                        <h2 class="text-secondary mb-0"><field name="dispatched_in_transit"/></h2>
                                    </div>
                                    <div class="fs-1 text-secondary opacity-50"><i class="fa fa-truck"/></div>
                                </div>
                                <div class="mt-3 text-muted small">
                                    Dispatched / Runner delivery
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="card shadow-sm h-100 p-3 border-primary">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted mb-1 text-uppercase fw-bold">External Labs</h6>
                                        <h2 class="text-primary mb-0"><field name="external_lab_pending"/></h2>
                                    </div>
                                    <div class="fs-1 text-primary opacity-50"><i class="fa fa-external-link"/></div>
                                </div>
                                <div class="mt-3">
                                    <button name="action_view_external_pending" type="object" string="View External" class="btn btn-outline-primary btn-sm w-100"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="card shadow-sm h-100 p-3 border-danger">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted mb-1 text-uppercase fw-bold">Overdue Orders</h6>
                                        <h2 class="text-danger mb-0"><field name="overdue_orders_count"/></h2>
                                    </div>
                                    <div class="fs-1 text-danger opacity-50"><i class="fa fa-clock-o"/></div>
                                </div>
                                <div class="mt-3">
                                    <button name="action_view_overdue" type="object" string="Urgent Attention" class="btn btn-outline-danger btn-sm w-100"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 3: Material Inventory & Clinical Intake -->
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="card shadow-sm p-3">
                                <h5 class="card-title text-muted mb-3"><i class="fa fa-archive me-2"/>Materials &amp; Stock Alerts</h5>
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <span>Low Stock Materials &amp; Consumables</span>
                                    <span class="badge bg-danger fs-6"><field name="low_stock_materials_count"/></span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <span>Active Manufacturing Production Orders</span>
                                    <span class="badge bg-info fs-6"><field name="active_mrp_count"/></span>
                                </div>
                                <div class="mt-3">
                                    <button name="action_view_low_stock" type="object" string="Review Low Stock Materials" class="btn btn-outline-secondary btn-sm"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card shadow-sm p-3">
                                <h5 class="card-title text-muted mb-3"><i class="fa fa-user-md me-2"/>Clinic Seating &amp; Acceptance</h5>
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <span>Orders Received at Clinic Awaiting Doctor Seating</span>
                                    <span class="badge bg-warning fs-6"><field name="awaiting_dentist_acceptance"/></span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <span>Pending Submissions (Draft Orders)</span>
                                    <span class="badge bg-secondary fs-6"><field name="awaiting_submission"/></span>
                                </div>
                                <div class="mt-3">
                                    <span class="text-muted small">Orders require doctor clinical fit acceptance before final closure.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Lab Dashboard -->
    <record id="action_dental_lab_dashboard_window" model="ir.actions.act_window">
        <field name="name">Laboratory KPI Dashboard</field>
        <field name="res_model">dental.lab.dashboard</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="dental_lab.dental_lab_dashboard_record"/>
        <field name="target">current</field>
    </record>
</odoo>
