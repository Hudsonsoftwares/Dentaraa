    <record id="product_finished_nightguard_template" model="product.template">
        <field name="name">Thermoformed Hard-Soft Occlusal Splint / Nightguard</field>
        <field name="default_code">LAB-SPLINT-NIGHT</field>
        <field name="categ_id" ref="product_category_orthodontic_appliances"/>
        <field name="type">consu</field>
        <field name="list_price">180.0</field>
        <field name="standard_price">45.0</field>
        <field name="uom_id" ref="uom.product_uom_unit"/>
        <field name="is_dental_lab_item">True</field>
        <field name="dental_lab_type">orthodontic</field>
        <field name="is_patient_specific">True</field>
        <field name="lab_turnaround_days">2</field>
    </record>

    <!-- Manufacturing Bill of Materials (BOM) for Zirconia Crown -->
    <record id="bom_zirconia_crown" model="mrp.bom">
        <field name="product_tmpl_id" ref="product_finished_zirconia_crown_template"/>
        <field name="product_qty">1.0</field>
        <field name="type">normal</field>
        <field name="bom_line_ids" eval="[
            (0, 0, {'product_id': ref('product_zirconia_disc_a2'), 'product_qty': 0.05}),
            (0, 0, {'product_id': ref('product_milling_bur_2mm'), 'product_qty': 0.02}),
            (0, 0, {'product_id': ref('product_glaze_paste_5g'), 'product_qty': 0.1}),
        ]"/>
    </record>
</odoo>
