<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_dental_pharmacy" model="ir.ui.view">
        <field name="name">account.move.form.inherit.dental.pharmacy</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Smart Button for Originating Pharmacy Dispense -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_pharmacy_dispense"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-medkit"
                        invisible="not pharmacy_dispense_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Pharmacy Order</span>
                    </div>
                </button>
            </xpath>

            <!-- Dental Clinical Links in Other Info Tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Dental &amp; Pharmacy Details" name="dental_pharmacy_info" invisible="not is_pharmacy_invoice">
                    <group>
                        <group string="Originating Clinical Documents">
                            <field name="dental_case_id" readonly="1"/>
                            <field name="dental_prescription_id" readonly="1"/>
                            <field name="pharmacy_dispense_id" readonly="1"/>
                            <field name="is_pharmacy_invoice" invisible="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
