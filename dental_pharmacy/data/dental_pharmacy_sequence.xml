<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Dental Prescriptions -->
        <record id="seq_dental_prescription" model="ir.sequence">
            <field name="name">Dental Prescription Sequence</field>
            <field name="code">dental.prescription</field>
            <field name="prefix">RX/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Pharmacy Dispense Orders -->
        <record id="seq_dental_pharmacy_dispense" model="ir.sequence">
            <field name="name">Pharmacy Dispense Order Sequence</field>
            <field name="code">dental.pharmacy.dispense</field>
            <field name="prefix">DISP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
