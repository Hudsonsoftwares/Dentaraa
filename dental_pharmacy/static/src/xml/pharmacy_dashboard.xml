<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dental_pharmacy.PharmacyDashboard">
        <div class="o_pharmacy_dashboard container-fluid py-4 px-4">
            <!-- Header Banner -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 p-4 rounded-4 shadow-sm bg-gradient-header">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
                            <i class="fa fa-hospital-o me-1"/> Dental Pharmacy Unit
                        </span>
                        <span class="text-white-50 small" t-out="this.currentDateStr"/>
                    </div>
                    <h2 class="h3 fw-bold text-white mb-1">Pharmacy Operations Command Center</h2>
                    <p class="text-white-50 mb-0 small">Real-time prescription dispensing, batch expiry tracking, and inventory control</p>
                </div>
                <div class="d-flex gap-2 mt-3 mt-md-0">
                    <button class="btn btn-outline-light btn-sm shadow-sm" t-on-click="() => this.loadData()">
                        <i class="fa fa-refresh me-1"/> Refresh
                    </button>
                    <button class="btn btn-primary btn-sm shadow-sm" t-on-click="() => this.newDispense()">
                        <i class="fa fa-plus me-1"/> Dispense Order
                    </button>
                    <button class="btn btn-light btn-sm shadow-sm" t-on-click="() => this.newPrescription()">
                        <i class="fa fa-stethoscope me-1"/> New Prescription
                    </button>
                    <button class="btn btn-outline-light btn-sm shadow-sm" t-on-click="() => this.newMedicine()">
                        <i class="fa fa-medkit me-1"/> Add Medicine
                    </button>
                </div>
            </div>

            <!-- KPI Row 1: Inventory Health -->
            <div class="mb-4">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h5 class="fw-bold text-dark mb-0 fs-6 text-uppercase tracking-wider">
                        <i class="fa fa-cubes text-primary me-2"/> Medicine Catalog &amp; Inventory Status
                    </h5>
                    <a href="#" class="text-decoration-none small text-primary fw-semibold" t-on-click="() => this.openFilteredMedicines('all')">View All Medicines &#8594;</a>
                </div>
                <div class="row g-3">
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card h-100 border-0 shadow-sm rounded-3 kpi-card cursor-pointer" t-on-click="() => this.openFilteredMedicines('all')">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-muted small fw-medium">Total Medicines</div>
                                        <div class="fs-3 fw-bold text-dark mt-1" t-out="this.state.data.total_medicines"/>
                                    </div>
                                    <div class="icon-circle bg-primary-subtle text-primary">
                                        <i class="fa fa-medkit fs-5"/>
                                    </div>
                                </div>
                                <div class="small text-muted mt-2">Active formulary items</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card h-100 border-0 shadow-sm rounded-3 kpi-card cursor-pointer" t-on-click="() => this.openFilteredMedicines('in_stock')">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-muted small fw-medium">In-Stock</div>
                                        <div class="fs-3 fw-bold text-success mt-1" t-out="this.state.data.in_stock"/>
                                    </div>
                                    <div class="icon-circle bg-success-subtle text-success">
                                        <i class="fa fa-check-circle-o fs-5"/>
                                    </div>
                                </div>
                                <div class="small text-muted mt-2">Adequate stock levels</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card h-100 border-0 shadow-sm rounded-3 kpi-card cursor-pointer" t-on-click="() => this.openFilteredMedicines('low_stock')">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-muted small fw-medium">Low Stock Alerts</div>
                                        <div class="fs-3 fw-bold text-warning mt-1" t-out="this.state.data.low_stock"/>
                                    </div>
                                    <div class="icon-circle bg-warning-subtle text-warning">
                                        <i class="fa fa-exclamation-triangle fs-5"/>
                                    </div>
                                </div>
                                <div class="small text-muted mt-2">At or below reorder level</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card h-100 border-0 shadow-sm rounded-3 kpi-card cursor-pointer" t-on-click="() => this.openFilteredMedicines('out_of_stock')">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-muted small fw-medium">Out of Stock</div>
                                        <div class="fs-3 fw-bold text-danger mt-1" t-out="this.state.data.out_of_stock"/>
                                    </div>
                                    <div class="icon-circle bg-danger-subtle text-danger">
                                        <i class="fa fa-times-circle fs-5"/>
                                    </div>
                                </div>
                                <div class="small text-muted mt-2">Urgent procurement required</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- KPI Row 2: Batch Safety & Prescriptions -->
            <div class="mb-4">
                <div class="row g-3">
                    <!-- Batch Expiry Cards -->
                    <div class="col-12 col-lg-6">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h5 class="fw-bold text-dark mb-0 fs-6 text-uppercase tracking-wider">
                                <i class="fa fa-calendar-check-o text-info me-2"/> Batch Tracking &amp; Expiry Safety
                            </h5>
                            <a href="#" class="text-decoration-none small text-info fw-semibold" t-on-click="() => this.openFilteredBatches('all')">Manage Batches &#8594;</a>
                        </div>
                        <div class="row g-3">
                            <div class="col-6 col-sm-4">
                                <div class="card h-100 border-0 shadow-sm rounded-3 kpi-card cursor-pointer" t-on-click="() => this.openFilteredBatches('valid')">
                                    <div class="card-body p-3">
                                        <div class="text-muted small">Valid Batches</div>
                                        <div class="fs-4 fw-bold text-success mt-1" t-out="this.state.data.valid_batches"/>
                                        <div class="badge bg-success-subtle text-success small mt-2">Safe to Dispense</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4">
                                <div class="card h-100 border-0 shadow-sm rounded-3 kpi-card cursor-pointer" t-on-click="() => this.openFilteredBatches('near_expiry')">
                                    <div class="card-body p-3">
                                        <div class="text-muted small">Near Expiry (&lt;= 60d)</div>
                                        <div class="fs-4 fw-bold text-warning mt-1" t-out="this.state.data.near_expiry_batches"/>
                                        <div class="badge bg-warning-subtle text-warning small mt-2">Dispense FEFO</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-4">
                                <div class="card h-100 border-0 shadow-sm rounded-3 kpi-card cursor-pointer" t-on-click="() => this.openFilteredBatches('expired')">
                                    <div class="card-body p-3">
                                        <div class="text-muted small">Expired Batches</div>
                                        <div class="fs-4 fw-bold text-danger mt-1" t-out="this.state.data.expired_batches"/>
                                        <div class="badge bg-danger-subtle text-danger small mt-2">Strictly Blocked</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Clinical Prescriptions & Dispensing Ops -->
                    <div class="col-12 col-lg-6">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h5 class="fw-bold text-dark mb-0 fs-6 text-uppercase tracking-wider">
                                <i class="fa fa-stethoscope text-primary me-2"/> Clinical Prescriptions &amp; Revenue
                            </h5>
                            <a href="#" class="text-decoration-none small text-primary fw-semibold" t-on-click="() => this.openFilteredPrescriptions('all')">All Prescriptions &#8594;</a>
                        </div>
                        <div class="row g-3">
                            <div class="col-6 col-sm-4">
                                <div class="card h-100 border-0 shadow-sm rounded-3 kpi-card cursor-pointer border-start border-4 border-info" t-on-click="() => this.openFilteredPrescriptions('pending')">
                                    <div class="card-body p-3">
                                        <div class="text-muted small">Pending Queue</div>
                                        <div class="fs-4 fw-bold text-info mt-1" t-out="this.state.data.pending_prescriptions"/>
                                        <div class="badge bg-info-subtle text-info small mt-2">Ready to Dispense</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4">
                                <div class="card h-100 border-0 shadow-sm rounded-3 kpi-card cursor-pointer" t-on-click="() => this.openFilteredPrescriptions('partially_dispensed')">
                                    <div class="card-body p-3">
                                        <div class="text-muted small">Partial Dispensed</div>
                                        <div class="fs-4 fw-bold text-warning mt-1" t-out="this.state.data.partially_dispensed"/>
                                        <div class="badge bg-warning-subtle text-warning small mt-2">In Progress</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-4">
                                <div class="card h-100 border-0 shadow-sm rounded-3 kpi-card cursor-pointer border-start border-4 border-success" t-on-click="() => this.openDispenseOrders('today')">
                                    <div class="card-body p-3">
                                        <div class="text-muted small">Today's Revenue</div>
                                        <div class="fs-5 fw-bold text-success mt-1" t-out="this.formatCurrency(this.state.data.today_dispensed_amount)"/>
                                        <div class="badge bg-success-subtle text-success small mt-2" t-out="this.state.data.today_dispensed_count + ' Orders Today'"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Two-Column Operational Queues -->
            <div class="row g-4">
                <!-- Column 1: Pending Prescriptions Queue -->
                <div class="col-12 col-xl-6">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="fa fa-clock-o text-primary me-2"/> Active Prescriptions Ready for Dispensing
                            </h6>
                            <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.openFilteredPrescriptions('pending')">
                                View Queue
                            </button>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>Prescription</th>
                                            <th>Patient</th>
                                            <th>Prescribing Doctor</th>
                                            <th class="text-center">Remaining</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody class="small">
                                        <t t-if="!this.state.data.pending_prescriptions_list || this.state.data.pending_prescriptions_list.length === 0">
                                            <tr>
                                                <td colspan="5" class="text-center py-4 text-muted">
                                                    <i class="fa fa-check-circle-o fa-2x mb-2 text-success"/><br/>
                                                    No pending prescriptions. All medications dispensed!
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-else="">
                                            <tr t-foreach="this.state.data.pending_prescriptions_list" t-as="rx" t-key="rx.id">
                                                <td>
                                                    <a href="#" class="fw-bold text-primary text-decoration-none" t-on-click="() => this.openRecord('dental.prescription', rx.id)">
                                                        <t t-out="rx.name"/>
                                                    </a>
                                                    <div class="text-muted small" t-out="rx.date"/>
                                                </td>
                                                <td><b t-out="rx.patient_name"/></td>
                                                <td><span t-out="rx.dentist_name"/></td>
                                                <td class="text-center">
                                                    <span class="badge text-bg-warning px-2 py-1"><t t-out="rx.remaining_qty"/> items</span>
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-success py-1 px-2" t-on-click="() => this.openRecord('dental.prescription', rx.id)">
                                                        <i class="fa fa-check me-1"/> Dispense
                                                    </button>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Column 2: Recent Dispensing Activity -->
                <div class="col-12 col-xl-6">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="fa fa-history text-success me-2"/> Recent Dispensing Transactions
                            </h6>
                            <button class="btn btn-sm btn-outline-success" t-on-click="() => this.openDispenseOrders('all')">
                                All Dispenses
                            </button>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>Order #</th>
                                            <th>Patient</th>
                                            <th>Date &amp; Time</th>
                                            <th class="text-end">Amount</th>
                                            <th class="text-center">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody class="small">
                                        <t t-if="!this.state.data.recent_dispenses || this.state.data.recent_dispenses.length === 0">
                                            <tr>
                                                <td colspan="5" class="text-center py-4 text-muted">
                                                    No recent dispensing transactions recorded yet.
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-else="">
                                            <tr t-foreach="this.state.data.recent_dispenses" t-as="disp" t-key="disp.id">
                                                <td>
                                                    <a href="#" class="fw-bold text-dark text-decoration-none" t-on-click="() => this.openRecord('dental.pharmacy.dispense', disp.id)">
                                                        <t t-out="disp.name"/>
                                                    </a>
                                                </td>
                                                <td><span t-out="disp.patient_name"/></td>
                                                <td><span class="text-muted" t-out="disp.date"/></td>
                                                <td class="text-end fw-bold text-success"><t t-out="this.formatCurrency(disp.amount_total)"/></td>
                                                <td class="text-center">
                                                    <span t-if="disp.state == 'dispensed'" class="badge text-bg-success">Dispensed</span>
                                                    <span t-elif="disp.state == 'returned'" class="badge text-bg-danger">Returned</span>
                                                    <span t-else="" class="badge text-bg-secondary"><t t-out="disp.state"/></span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Column 3: Low Stock Warnings -->
                <div class="col-12 col-xl-6">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="fa fa-exclamation-circle text-danger me-2"/> Low Stock &amp; Reorder Alerts
                            </h6>
                            <button class="btn btn-sm btn-outline-danger" t-on-click="() => this.openFilteredMedicines('low_stock')">
                                View Alerts
                            </button>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>Medicine</th>
                                            <th>On Hand</th>
                                            <th>Min Stock</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody class="small">
                                        <t t-if="!this.state.data.low_stock_list || this.state.data.low_stock_list.length === 0">
                                            <tr>
                                                <td colspan="4" class="text-center py-4 text-muted">
                                                    <i class="fa fa-check-circle text-success fa-2x mb-2"/><br/>
                                                    All medicine stocks are at safe replenishment levels!
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-else="">
                                            <tr t-foreach="this.state.data.low_stock_list" t-as="med" t-key="med.id">
                                                <td>
                                                    <a href="#" class="fw-bold text-dark text-decoration-none" t-on-click="() => this.openRecord('product.template', med.id)">
                                                        <t t-out="med.name"/>
                                                    </a>
                                                    <div class="text-muted small" t-out="med.generic_name"/>
                                                </td>
                                                <td><b class="text-danger"><t t-out="med.qty_available"/> <t t-out="med.dosage_unit"/></b></td>
                                                <td><span class="text-muted"><t t-out="med.reorder_level"/> <t t-out="med.dosage_unit"/></span></td>
                                                <td>
                                                    <span t-if="med.status == 'Out of Stock'" class="badge text-bg-danger">Out of Stock</span>
                                                    <span t-else="" class="badge text-bg-warning">Low Stock</span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Column 4: Critical Batch Expiry Watch -->
                <div class="col-12 col-xl-6">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="fa fa-shield text-warning me-2"/> Batch Expiry Safety Watch (FEFO)
                            </h6>
                            <button class="btn btn-sm btn-outline-warning" t-on-click="() => this.openFilteredBatches('near_expiry')">
                                Manage Batches
                            </button>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>Batch #</th>
                                            <th>Medicine</th>
                                            <th>Expiry Date</th>
                                            <th>Days Left</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody class="small">
                                        <t t-if="!this.state.data.near_expiry_list || this.state.data.near_expiry_list.length === 0">
                                            <tr>
                                                <td colspan="5" class="text-center py-4 text-muted">
                                                    <i class="fa fa-shield text-success fa-2x mb-2"/><br/>
                                                    All stock batches have valid expiration dates!
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-else="">
                                            <tr t-foreach="this.state.data.near_expiry_list" t-as="lot" t-key="lot.id">
                                                <td>
                                                    <a href="#" class="fw-bold text-dark text-decoration-none" t-on-click="() => this.openRecord('stock.lot', lot.id)">
                                                        <t t-out="lot.name"/>
                                                    </a>
                                                </td>
                                                <td><span t-out="lot.product_name"/></td>
                                                <td><span t-out="lot.expiry_date"/></td>
                                                <td>
                                                    <span t-if="lot.status == 'Expired'" class="badge text-bg-danger">Expired (<t t-out="lot.days_to_expiry"/>d)</span>
                                                    <span t-else="" class="badge text-bg-warning"><t t-out="lot.days_to_expiry"/> days</span>
                                                </td>
                                                <td>
                                                    <span t-if="lot.status == 'Expired'" class="text-danger small fw-bold">DO NOT DISPENSE</span>
                                                    <span t-else="" class="text-warning small fw-bold">Dispense First</span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
