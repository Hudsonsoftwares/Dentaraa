<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cash Flow Statement report action -->
    <record id="action_report_cash_flow" model="ir.actions.report">
        <field name="name">Cash Flow Statement</field>
        <field name="model">account.cash.flow.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hudson_accounting_enhancements.report_cf</field>
        <field name="print_report_name">'Cash Flow Statement - %s' % object.company_id.name</field>
        <field name="binding_model_id" ref="base.model_res_users"/>
    </record>

    <!-- Paperformat for Annual Financial Report -->
    <record id="paperformat_annual_report" model="report.paperformat">
        <field name="name">Annual Financial Report A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <!-- Annual Report action -->
    <record id="action_report_annual" model="ir.actions.report">
        <field name="name">Annual Financial Report</field>
        <field name="model">account.annual.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hudson_accounting_enhancements.report_annual</field>
        <field name="print_report_name">'Annual Report - %s' % object.company_id.name</field>
        <field name="paperformat_id" ref="paperformat_annual_report"/>
    </record>

    <!-- Executive Summary report action -->
    <record id="action_report_executive_summary" model="ir.actions.report">
        <field name="name">Executive Summary</field>
        <field name="model">account.executive.summary.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hudson_accounting_enhancements.report_exec_sum</field>
        <field name="print_report_name">'Executive Summary - %s' % object.company_id.name</field>
    </record>

    <!-- Unrealized Currency report action -->
    <record id="action_report_unrealized_currency" model="ir.actions.report">
        <field name="name">Unrealized Currency Gains/Losses</field>
        <field name="model">account.unrealized.currency.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hudson_accounting_enhancements.report_unreal_ccy</field>
        <field name="print_report_name">'Unrealized Currency - %s' % object.company_id.name</field>
    </record>

    <!-- Extended Tax Report action -->
    <record id="action_report_tax_extended" model="ir.actions.report">
        <field name="name">Tax Report (Extended)</field>
        <field name="model">account.tax.extended.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hudson_accounting_enhancements.report_tax_ext</field>
        <field name="print_report_name">'Tax Report Extended - %s' % object.company_id.name</field>
    </record>
</odoo>
