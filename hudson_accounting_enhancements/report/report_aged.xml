    <!-- ── IR Actions for PDF reports ────────────────────────────────── -->
    <record id="action_report_aged_receivable" model="ir.actions.report">
        <field name="name">Aged Receivable</field>
        <field name="model">account.aged.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hudson_accounting_enhancements.report_aged_receivable</field>
        <field name="print_report_name">'Aged Receivable - %s' % object.company_id.name</field>
    </record>

    <record id="action_report_aged_payable" model="ir.actions.report">
        <field name="name">Aged Payable</field>
        <field name="model">account.aged.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hudson_accounting_enhancements.report_aged_payable</field>
        <field name="print_report_name">'Aged Payable - %s' % object.company_id.name</field>
    </record>
</odoo>
