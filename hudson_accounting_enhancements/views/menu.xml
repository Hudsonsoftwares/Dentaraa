    'name': 'Balance Sheet',
    'type': 'ir.actions.client',
    'tag': 'hudson_dynamic_reports.dynamic_report',
    'params': {
        'model_name': 'accounting.report',
        'wizard_id': wiz.id,
        'data': data,
    }
}
