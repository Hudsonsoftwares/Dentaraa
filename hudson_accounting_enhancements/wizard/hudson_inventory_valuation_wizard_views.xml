<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hudson_inventory_valuation_wizard_form" model="ir.ui.view">
        <field name="name">hudson.inventory.valuation.wizard.form</field>
        <field name="model">hudson.inventory.valuation.wizard</field>
        <field name="arch" type="xml">
            <form string="Inventory Valuation" create="0" delete="0">
                <header>
                    <button string="Generate Entry" name="action_generate_entry" type="object" class="btn-secondary"/>
                    <div class="oe_right oe_inline ms-auto d-flex align-items-center">
                        <span class="text-muted me-2" style="font-size: 1.1em;"><i class="fa fa-calendar"/> As of</span>
                        <field name="as_of_date" widget="date" readonly="0" class="oe_inline fw-bold p-1 bg-200 border rounded"/>
                    </div>
                </header>
                <sheet>
                    <field name="report_html" widget="html" readonly="1" nolabel="1" class="w-100"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hudson_inventory_valuation" model="ir.actions.act_window">
        <field name="name">Inventory Valuation</field>
        <field name="res_model">hudson.inventory.valuation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
