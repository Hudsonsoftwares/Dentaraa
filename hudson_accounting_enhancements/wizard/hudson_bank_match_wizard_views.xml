<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hudson_bank_match_wizard_form" model="ir.ui.view">
        <field name="name">hudson.bank.match.wizard.form</field>
        <field name="model">hudson.bank.match.wizard</field>
        <field name="arch" type="xml">
            <form string="Matching Suggestions">
                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="amount" class="oe_inline"/>
                            <field name="currency_id" class="oe_inline" invisible="1"/>
                        </h2>
                        <h4>
                            <field name="partner_id" readonly="1" class="oe_inline"/>
                        </h4>
                    </div>
                    
                    <notebook>
                        <page string="Suggestions">
                            <field name="move_line_ids" widget="many2many">
                                <list string="Matches" create="0">
                                    <field name="date"/>
                                    <field name="move_id"/>
                                    <field name="account_id"/>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="amount_residual"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Validate" type="object" name="action_validate" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
