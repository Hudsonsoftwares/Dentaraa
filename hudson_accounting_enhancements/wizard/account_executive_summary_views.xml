<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_executive_summary_wizard" model="ir.ui.view">
        <field name="name">account.executive.summary.wizard.form</field>
        <field name="model">account.executive.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Executive Summary">
                <field name="state" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                
                <header>
                    <button name="action_generate"
                            string="Generate Report"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'choose'"/>
                    <button name="action_print_report"
                            string="Print PDF"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_recompute"
                            string="Reconfigure"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'get'"/>
                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"/>
                </header>
                
                <sheet>
                    <!-- State: Choose Parameters -->
                    <div invisible="state != 'choose'">
                        <group>
                            <group string="Current Period">
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="target_move" widget="radio"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                    </div>
                    
                    <!-- State: View Report -->
                    <div invisible="state != 'get'">
                        <field name="report_html" widget="html" nolabel="1" readonly="1" options="{'style-inline': true}"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_executive_summary_wizard" model="ir.actions.act_window">
        <field name="name">Executive Summary</field>
        <field name="res_model">account.executive.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_account_executive_summary_wizard"/>
        <field name="target">current</field>
    </record>
</odoo>
