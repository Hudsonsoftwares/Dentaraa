<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dental_core.DentistDashboard">
        <div class="o_action o_dental_dashboard w-100 h-100 overflow-auto p-4">
            
            <!-- Top Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="text-dark-blue fw-bold mb-1">Good Morning, Dr. <t t-esc="this.userName"/> ☀️</h2>
                    <p class="text-muted-blue fs-6 mb-0"><t t-esc="this.currentDateStr"/></p>
                </div>
                <div>
                    <!-- Branch/Clinic selector placeholder or similar actions could go here -->
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="row g-4 mb-4">
                <div class="col-md-3">
                    <div class="card border-0 p-4 h-100 dashboard-stat-card cursor-pointer" t-on-click="() =&gt; this.openAction('dental_core.action_dentist_workspace_todays_appointments')">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-box bg-primary-soft rounded-3 me-3">
                                <i class="fa fa-calendar"/>
                            </div>
                            <span class="text-success fw-bold" style="color: #0369a1 !important;">Today's Appointments</span>
                        </div>
                        <h1 class="fw-bold text-dark-blue mb-1"><t t-esc="this.state.stats.today_appointments"/></h1>
                        <div class="text-muted-blue" style="font-size: 0.85rem;">
                            <span class="text-primary"><t t-esc="this.state.stats.completed_appointments"/> Completed</span> • <t t-esc="this.state.stats.pending_appointments"/> Pending
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 p-4 h-100 dashboard-stat-card cursor-pointer" t-on-click="() =&gt; this.openAction('dental_core.action_dentist_workspace_queue')">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-box bg-success-soft rounded-3 me-3">
                                <i class="fa fa-users"/>
                            </div>
                            <span class="text-success fw-bold">Waiting Patients</span>
                        </div>
                        <h1 class="fw-bold text-dark-blue mb-1"><t t-esc="this.state.stats.waiting_patients"/></h1>
                        <div class="text-muted-blue" style="font-size: 0.85rem;">
                            Avg. Waiting Time <t t-esc="this.state.stats.avg_waiting_time"/> mins
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 p-4 h-100 dashboard-stat-card cursor-pointer" t-on-click="() =&gt; this.openAction('dental_core.action_dentist_workspace_active_cases')">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-box bg-purple-soft rounded-3 me-3">
                                <i class="fa fa-tooth"/>
                            </div>
                            <span class="fw-bold" style="color: #6b21a8 !important;">Active Dental Cases</span>
                        </div>
                        <h1 class="fw-bold text-dark-blue mb-1"><t t-esc="this.state.stats.active_cases"/></h1>
                        <div class="text-muted-blue" style="font-size: 0.85rem;">
                            <t t-esc="this.state.stats.under_treatment_cases"/> Under Treatment
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 p-4 h-100 dashboard-stat-card cursor-pointer" t-on-click="() =&gt; this.openAction('dental_core.action_dentist_workspace_pending_sessions')">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-box bg-warning-soft rounded-3 me-3">
                                <i class="fa fa-check-square-o"/>
                            </div>
                            <span class="fw-bold" style="color: #9a3412 !important;">Today's Procedures</span>
                        </div>
                        <h1 class="fw-bold text-dark-blue mb-1"><t t-esc="this.state.stats.today_sessions"/></h1>
                        <div class="text-muted-blue" style="font-size: 0.85rem;">
                            <span class="text-warning" style="color: #ea580c !important;"><t t-esc="this.state.stats.completed_sessions"/> Completed</span> • <t t-esc="this.state.stats.pending_sessions"/> Pending
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content Grid -->
            <div class="row g-4">
                
                <!-- Left Column (col-md-8) -->
                <div class="col-md-8">
                    <!-- Today's Appointments -->
                    <div class="card border-0 mb-4">
                        <div class="card-header bg-white border-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold text-dark-blue mb-0">
                                <div class="d-inline-flex align-items-center justify-content-center bg-primary-soft rounded text-primary me-2" style="width:28px; height:28px; font-size:14px;"><i class="fa fa-stethoscope"/></div>
                                Today's Appointments (<t t-esc="this.state.stats.today_appointments"/>)
                            </h5>
                            <a href="#" class="text-primary text-decoration-none fw-bold" style="font-size:0.9rem;" t-on-click.prevent="() =&gt; this.openAction('dental_core.action_dentist_workspace_todays_appointments')">View Calendar <i class="fa fa-chevron-right ms-1" style="font-size:0.75rem;"/></a>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-borderless table-hover align-middle mb-0">
                                    <thead style="background-color: #f8fafc; color: #64748b; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                                        <tr>
                                            <th class="ps-4">Time</th>
                                            <th>Patient</th>
                                            <th>Visit Type</th>
                                            <th>Status</th>
                                            <th class="pe-4">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-if="this.state.today_appointments_list.length == 0">
                                            <td colspan="5" class="text-center text-muted py-4">No appointments for today.</td>
                                        </tr>
                                        <tr t-foreach="this.state.today_appointments_list" t-as="appt" t-key="appt.id" class="border-bottom">
                                            <td class="ps-4 text-muted-blue fw-semibold" style="font-size: 0.95rem;"><t t-esc="this.formatTime(appt.date_start)"/></td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <img class="rounded-circle me-3" t-attf-src="/web/image?model=res.partner&amp;field=avatar_128&amp;id={{appt.patient_id[0]}}" style="width: 40px; height: 40px; object-fit: cover; border: 1px solid #e2e8f0;"/>
                                                    <div>
                                                        <div class="fw-bold text-dark-blue"><t t-esc="appt.patient_id[1]"/></div>
                                                        <div class="text-muted-blue" style="font-size: 0.8rem;">ID: <t t-esc="appt.patient_id[0]"/></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-muted-blue" style="font-size: 0.95rem;">
                                                <t t-esc="appt.treatment_id ? appt.treatment_id[1] : 'Consultation'"/>
                                            </td>
                                            <td>
                                                <span t-if="appt.state == 'pending'" class="badge rounded-pill bg-light text-muted-blue border px-3 py-2">Scheduled</span>
                                                <span t-if="appt.state == 'confirmed'" class="badge rounded-pill bg-light text-muted-blue border px-3 py-2">Confirmed</span>
                                                <span t-if="appt.state == 'checked_in'" class="badge rounded-pill bg-warning-soft px-3 py-2">Waiting</span>
                                                <span t-if="appt.state == 'in_consultation'" class="badge rounded-pill bg-info-soft px-3 py-2">In Consultation</span>
                                                <span t-if="appt.state == 'completed'" class="badge rounded-pill bg-success-soft px-3 py-2">Completed</span>
                                            </td>
                                            <td class="pe-4">
                                                <div class="d-flex align-items-center">
                                                    <button t-if="appt.state == 'checked_in'" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold" t-on-click="() =&gt; this.startConsultation(appt.id)">Start Consultation</button>
                                                    <button t-elif="appt.state == 'pending'" class="btn btn-light border btn-sm rounded-pill px-3 fw-semibold" t-on-click="() =&gt; this.openRecord('dental.appointment', appt.id)">Check In</button>
                                                    <button t-else="1" class="btn btn-light border btn-sm rounded-pill px-3 fw-semibold text-primary" t-on-click="() =&gt; this.openRecord('dental.appointment', appt.id)">View Case</button>
                                                    <a href="#" class="text-muted ms-3"><i class="fa fa-ellipsis-v"/></a>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <!-- Recent Dental Cases -->
                        <div class="col-md-6">
                            <div class="card border-0 h-100">
                                <div class="card-header bg-white border-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
                                    <h6 class="fw-bold text-dark-blue mb-0">
                                        <div class="d-inline-flex align-items-center justify-content-center bg-primary-soft rounded text-primary me-2" style="width:24px; height:24px; font-size:12px;"><i class="fa fa-folder-open"/></div>
                                        Recent Dental Cases
                                    </h6>
                                    <a href="#" class="text-primary text-decoration-none" style="font-size:0.85rem;" t-on-click.prevent="() =&gt; this.openAction('dental_core.action_dentist_workspace_active_cases')">View All <i class="fa fa-chevron-right ms-1" style="font-size:0.75rem;"/></a>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-borderless table-sm align-middle mb-0" style="font-size: 0.9rem;">
                                            <thead style="background-color: #f8fafc; color: #64748b; font-size: 0.75rem; text-transform: uppercase;">
                                                <tr>
                                                    <th class="ps-4">Case Number</th>
                                                    <th>Patient</th>
                                                    <th>Problem</th>
                                                    <th class="pe-4">Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-if="this.state.recent_cases.length == 0">
                                                    <td colspan="4" class="text-center text-muted py-3">No recent cases.</td>
                                                </tr>
                                                <tr t-foreach="this.state.recent_cases" t-as="c" t-key="c.id" class="border-bottom">
                                                    <td class="ps-4 fw-semibold text-primary cursor-pointer" t-on-click="() =&gt; this.openRecord('dental.case', c.id)"><t t-esc="c.name"/></td>
                                                    <td class="text-dark-blue"><t t-esc="c.patient_id[1]"/></td>
                                                    <td class="text-muted-blue"><t t-esc="c.chief_complaint ? c.chief_complaint.substring(0,20) : 'None'"/></td>
                                                    <td class="pe-4">
                                                        <span t-if="c.state == 'open'" class="badge rounded-pill bg-info-soft px-2 py-1" style="font-size: 0.7rem;">Open</span>
                                                        <span t-if="c.state == 'under_treatment'" class="badge rounded-pill bg-warning-soft px-2 py-1" style="font-size: 0.7rem;">Under Treatment</span>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Today's Treatment Sessions -->
                        <div class="col-md-6">
                            <div class="card border-0 h-100">
                                <div class="card-header bg-white border-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
                                    <h6 class="fw-bold text-dark-blue mb-0">
                                        <div class="d-inline-flex align-items-center justify-content-center bg-primary-soft rounded text-primary me-2" style="width:24px; height:24px; font-size:12px;"><i class="fa fa-calendar-check-o"/></div>
                                        Today's Treatment Sessions
                                    </h6>
                                    <a href="#" class="text-primary text-decoration-none" style="font-size:0.85rem;" t-on-click.prevent="() =&gt; this.openAction('dental_core.action_dentist_workspace_pending_sessions')">View All <i class="fa fa-chevron-right ms-1" style="font-size:0.75rem;"/></a>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-borderless table-sm align-middle mb-0" style="font-size: 0.9rem;">
                                            <thead style="background-color: #f8fafc; color: #64748b; font-size: 0.75rem; text-transform: uppercase;">
                                                <tr>
                                                    <th class="ps-4">Time</th>
                                                    <th>Patient</th>
                                                    <th>Treatment</th>
                                                    <th class="pe-4">Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-if="this.state.today_sessions_list.length == 0">
                                                    <td colspan="4" class="text-center text-muted py-3">No sessions today.</td>
                                                </tr>
                                                <tr t-foreach="this.state.today_sessions_list" t-as="sess" t-key="sess.id" class="border-bottom cursor-pointer" t-on-click="() =&gt; this.openRecord('dental.treatment.session', sess.id)">
                                                    <td class="ps-4 text-muted-blue fw-semibold"><t t-esc="this.formatTime(sess.session_date)"/></td>
                                                    <td class="text-dark-blue"><t t-esc="sess.patient_id[1]"/></td>
                                                    <td class="text-muted-blue"><t t-esc="sess.plan_line_id ? sess.plan_line_id[1] : ''"/></td>
                                                    <td class="pe-4">
                                                        <span t-if="sess.state == 'planned'" class="badge rounded-pill bg-light border text-muted-blue px-2 py-1" style="font-size: 0.7rem;">Planned</span>
                                                        <span t-if="sess.state == 'in_progress'" class="badge rounded-pill bg-info-soft px-2 py-1" style="font-size: 0.7rem;">In Progress</span>
                                                        <span t-if="sess.state == 'completed'" class="badge rounded-pill bg-success-soft px-2 py-1" style="font-size: 0.7rem;">Completed</span>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column (col-md-4) -->
                <div class="col-md-4">
                    <!-- Waiting Queue -->
                    <div class="card border-0 mb-4">
                        <div class="card-header bg-white border-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold text-dark-blue mb-0">
                                <div class="d-inline-flex align-items-center justify-content-center bg-primary-soft rounded text-primary me-2" style="width:24px; height:24px; font-size:12px;"><i class="fa fa-list-ol"/></div>
                                Waiting Queue
                            </h6>
                            <a href="#" class="text-primary text-decoration-none" style="font-size:0.85rem;" t-on-click.prevent="() =&gt; this.openAction('dental_core.action_dentist_workspace_queue')">View All <i class="fa fa-chevron-right ms-1" style="font-size:0.75rem;"/></a>
                        </div>
                        <div class="card-body p-4 pt-3">
                            <div t-if="this.state.waiting_queue.length == 0" class="text-center text-muted-blue py-3">
                                <i class="fa fa-check-circle-o fa-2x mb-2 text-success-soft" style="color: #4ade80 !important;"/>
                                <p class="mb-0">Queue is empty</p>
                            </div>
                            <div t-foreach="this.state.waiting_queue" t-as="wait" t-key="wait.id" class="d-flex align-items-center mb-4 cursor-pointer" t-on-click="() =&gt; this.openRecord('dental.appointment', wait.id)">
                                <div class="bg-primary-soft text-primary rounded-circle d-flex justify-content-center align-items-center fw-bold me-3" style="width: 44px; height: 44px; font-size: 1.1rem;">
                                    <t t-esc="wait_index + 1"/>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold text-dark-blue mb-1" style="font-size: 0.95rem;"><t t-esc="wait.patient_id[1]"/></div>
                                    <div class="text-muted-blue" style="font-size: 0.8rem;"><t t-esc="this.formatTime(wait.date_start)"/> • <t t-esc="wait.treatment_id ? wait.treatment_id[1] : 'Consultation'"/></div>
                                </div>
                                <div class="text-danger fw-bold text-end" style="font-size: 0.85rem; color: #ea580c !important;">
                                    <t t-esc="wait.formatted_waiting_time"/> mins
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- My Calendar -->
                    <div class="card border-0">
                        <div class="card-header bg-white border-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold text-dark-blue mb-0">
                                <div class="d-inline-flex align-items-center justify-content-center bg-primary-soft rounded text-primary me-2" style="width:24px; height:24px; font-size:12px;"><i class="fa fa-calendar-check-o"/></div>
                                My Calendar
                            </h6>
                            <a href="#" class="text-primary text-decoration-none fw-bold" style="font-size:0.85rem;">Today <i class="fa fa-chevron-right ms-1" style="font-size:0.75rem;"/></a>
                        </div>
                        <div class="card-body p-4 pt-3">
                            <div t-if="this.state.calendar_events.length == 0" class="text-center text-muted-blue py-3">
                                No events today.
                            </div>
                            <div t-foreach="this.state.calendar_events" t-as="evt" t-key="evt.id" class="d-flex mb-3 timeline-item">
                                <div class="text-muted-blue fw-semibold text-end pe-3" style="font-size: 0.8rem; width: 70px; flex-shrink: 0;">
                                    <t t-esc="this.formatTime(evt.date_start)"/>
                                </div>
                                <div class="timeline-bullet"/>
                                <div class="flex-grow-1 ms-2 p-2 rounded-3" t-att-class="evt.state == 'completed' ? 'bg-success-soft' : (evt.state == 'in_consultation' ? 'bg-info-soft' : (evt.state == 'checked_in' ? 'bg-warning-soft' : 'bg-primary-soft'))">
                                    <div class="fw-bold" style="font-size: 0.85rem; color: #1e293b;"><t t-esc="evt.patient_id[1]"/></div>
                                    <div style="font-size: 0.75rem; opacity: 0.8;"><t t-esc="evt.treatment_id ? evt.treatment_id[1] : 'Consultation'"/></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
