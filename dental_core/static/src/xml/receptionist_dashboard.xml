<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dental_core.ReceptionistDashboard">
        <div class="o_action o_dental_dashboard w-100 h-100 overflow-auto p-4">
            
            <!-- Top Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="text-dark-blue fw-bold mb-1">Reception Desk 👋</h2>
                    <p class="text-muted-blue fs-6 mb-0"><t t-esc="this.currentDateStr"/></p>
                </div>
                <div>
                    <button class="btn btn-primary px-4 py-2 fw-semibold rounded-pill shadow-sm me-2" t-on-click="() => this.openNewPatient()">
                        <i class="fa fa-user-plus me-2"/> Register Patient
                    </button>
                    <button class="btn btn-outline-primary bg-white px-4 py-2 fw-semibold rounded-pill shadow-sm" t-on-click="() => this.openAction('dental_appointment.action_dental_appointment')">
                        <i class="fa fa-calendar-plus-o me-2"/> Book Appointment
                    </button>
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="row g-4 mb-4">
                <div class="col-md-3">
                    <div class="card border-0 p-4 h-100 dashboard-stat-card cursor-pointer" t-on-click="() => this.openAction('dental_core.action_reception_todays_appointments')">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-box bg-primary-soft rounded-3 me-3">
                                <i class="fa fa-calendar"/>
                            </div>
                            <span class="text-success fw-bold" style="color: #0369a1 !important;">Today's Appointments</span>
                        </div>
                        <h1 class="fw-bold text-dark-blue mb-1"><t t-esc="this.state.stats.today_appointments"/></h1>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 p-4 h-100 dashboard-stat-card cursor-pointer" t-on-click="() => this.openAction('dental_core.action_reception_checked_in')">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-box bg-warning-soft rounded-3 me-3">
                                <i class="fa fa-users"/>
                            </div>
                            <span class="text-success fw-bold" style="color: #d97706 !important;">Waiting Patients</span>
                        </div>
                        <h1 class="fw-bold text-dark-blue mb-1"><t t-esc="this.state.stats.waiting_patients"/></h1>
                        <div class="text-muted-blue" style="font-size: 0.85rem;">
                            <span class="text-warning" style="color: #ea580c !important;"><t t-esc="this.state.stats.checked_in_patients"/> Checked In</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 p-4 h-100 dashboard-stat-card cursor-pointer" t-on-click="() => this.openAction('dental_core.action_reception_patients')">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-box bg-success-soft rounded-3 me-3">
                                <i class="fa fa-user-plus"/>
                            </div>
                            <span class="fw-bold" style="color: #15803d !important;">New Patients</span>
                        </div>
                        <h1 class="fw-bold text-dark-blue mb-1"><t t-esc="this.state.stats.new_patients_today"/></h1>
                        <div class="text-muted-blue" style="font-size: 0.85rem;">Registered Today</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 p-4 h-100 dashboard-stat-card cursor-pointer" t-on-click="() => this.openAction('dental_appointment.action_dental_follow_up')">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-box bg-purple-soft rounded-3 me-3">
                                <i class="fa fa-phone"/>
                            </div>
                            <span class="fw-bold" style="color: #6b21a8 !important;">Upcoming Follow-ups</span>
                        </div>
                        <h1 class="fw-bold text-dark-blue mb-1"><t t-esc="this.state.stats.upcoming_follow_ups"/></h1>
                        <div class="text-muted-blue" style="font-size: 0.85rem;">Total Upcoming</div>
                    </div>
                </div>
            </div>

            <!-- Main Content Grid -->
            <div class="row g-4">
                
                <!-- Left Column (col-md-8) -->
                <div class="col-md-8">
                    <!-- Today's Appointments -->
                    <div class="card border-0 mb-4 h-100">
                        <div class="card-header bg-white border-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold text-dark-blue mb-0">
                                <div class="d-inline-flex align-items-center justify-content-center bg-primary-soft rounded text-primary me-2" style="width:28px; height:28px; font-size:14px;"><i class="fa fa-calendar-o"/></div>
                                Today's Appointments (<t t-esc="this.state.stats.today_appointments"/>)
                            </h5>
                            <a href="#" class="text-primary text-decoration-none fw-bold" style="font-size:0.9rem;" t-on-click.prevent="() => this.openAction('dental_core.action_reception_todays_appointments')">View All <i class="fa fa-chevron-right ms-1" style="font-size:0.75rem;"/></a>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-borderless table-hover align-middle mb-0">
                                    <thead style="background-color: #f8fafc; color: #64748b; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                                        <tr>
                                            <th class="ps-4">Time</th>
                                            <th>Patient</th>
                                            <th>Dentist</th>
                                            <th>Status</th>
                                            <th class="pe-4 text-center">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-if="this.state.today_appointments_list.length == 0">
                                            <td colspan="5" class="text-center text-muted py-5">
                                                <i class="fa fa-calendar-times-o fa-3x text-muted-blue opacity-50 mb-3 d-block"/>
                                                <p class="mb-3">No appointments for today.</p>
                                                <button class="btn btn-primary btn-sm rounded-pill px-4" t-on-click="() => this.openAction('dental_appointment.action_dental_appointment')">Book Appointment</button>
                                            </td>
                                        </tr>
                                        <tr t-foreach="this.state.today_appointments_list" t-as="appt" t-key="appt.id" class="border-bottom">
                                            <td class="ps-4 text-muted-blue fw-semibold" style="font-size: 0.95rem;"><t t-esc="this.formatTime(appt.date_start)"/></td>
                                            <td>
                                                <div class="d-flex align-items-center cursor-pointer" t-on-click="() => this.openRecord('res.partner', appt.patient_id[0])">
                                                    <img class="rounded-circle me-3" t-attf-src="/web/image?model=res.partner&amp;field=avatar_128&amp;id={{appt.patient_id[0]}}" style="width: 40px; height: 40px; object-fit: cover; border: 1px solid #e2e8f0;"/>
                                                    <div>
                                                        <div class="fw-bold text-dark-blue"><t t-esc="appt.patient_id[1]"/></div>
                                                        <div class="text-muted-blue" style="font-size: 0.8rem;">ID: <t t-esc="appt.patient_id[0]"/></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-dark-blue" style="font-size: 0.95rem;">
                                                <t t-esc="appt.doctor_id ? appt.doctor_id[1] : 'Any'"/>
                                            </td>
                                            <td>
                                                <span t-if="appt.state == 'pending'" class="badge rounded-pill bg-light text-muted-blue border px-3 py-2">Scheduled</span>
                                                <span t-if="appt.state == 'confirmed'" class="badge rounded-pill bg-light text-muted-blue border px-3 py-2">Confirmed</span>
                                                <span t-if="appt.state == 'checked_in'" class="badge rounded-pill bg-warning-soft px-3 py-2">Checked In</span>
                                                <span t-if="appt.state == 'in_consultation'" class="badge rounded-pill bg-info-soft px-3 py-2">In Consultation</span>
                                                <span t-if="appt.state == 'completed'" class="badge rounded-pill bg-success-soft px-3 py-2">Completed</span>
                                            </td>
                                            <td class="pe-4 text-center text-nowrap">
                                                <button t-if="appt.state == 'pending'" class="btn btn-success btn-sm rounded-pill px-3 fw-semibold me-1" t-on-click="() => this.updateAppointmentState(appt.id, 'action_confirm')">Confirm</button>
                                                <button t-if="appt.state == 'confirmed'" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold me-1" t-on-click="() => this.checkInPatient(appt.id)">Check In</button>
                                                <button t-if="appt.state == 'pending' || appt.state == 'confirmed'" class="btn btn-outline-danger btn-sm rounded-circle px-2 fw-semibold me-1" t-on-click="() => this.updateAppointmentState(appt.id, 'action_cancel')" title="Cancel"><i class="fa fa-times"/></button>
                                                <button class="btn btn-light border btn-sm rounded-pill px-3 fw-semibold text-primary" t-on-click="() => this.openRecord('dental.appointment', appt.id)">Manage</button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column (col-md-4) -->
                <div class="col-md-4">
                    <!-- Waiting Queue -->
                    <div class="card border-0 mb-4">
                        <div class="card-header bg-white border-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold text-dark-blue mb-0">
                                <div class="d-inline-flex align-items-center justify-content-center bg-warning-soft rounded text-warning me-2" style="width:24px; height:24px; font-size:12px;"><i class="fa fa-list-ol"/></div>
                                Waiting Queue
                            </h6>
                            <a href="#" class="text-primary text-decoration-none" style="font-size:0.85rem;" t-on-click.prevent="() => this.openAction('dental_core.action_reception_checked_in')">View Queue <i class="fa fa-chevron-right ms-1" style="font-size:0.75rem;"/></a>
                        </div>
                        <div class="card-body p-4 pt-3">
                            <div t-if="this.state.waiting_queue.length == 0" class="text-center text-muted-blue py-3">
                                <i class="fa fa-check-circle-o fa-2x mb-2 text-success-soft" style="color: #4ade80 !important;"/>
                                <p class="mb-0">No patients waiting</p>
                            </div>
                            <div t-foreach="this.state.waiting_queue" t-as="wait" t-key="wait.id" class="d-flex align-items-center mb-4 cursor-pointer" t-on-click="() => this.openRecord('dental.appointment', wait.id)">
                                <div class="bg-primary-soft text-primary rounded-circle d-flex justify-content-center align-items-center fw-bold me-3" style="width: 44px; height: 44px; font-size: 1.1rem;">
                                    <t t-esc="wait.token_number ? wait.token_number.split('-').pop() : wait_index + 1"/>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold text-dark-blue mb-1" style="font-size: 0.95rem;"><t t-esc="wait.patient_id[1]"/></div>
                                    <div class="text-muted-blue" style="font-size: 0.8rem;">To see <t t-esc="wait.doctor_id ? wait.doctor_id[1] : 'Any'"/></div>
                                </div>
                                <div class="text-danger fw-bold text-end" style="font-size: 0.85rem; color: #ea580c !important;">
                                    <t t-esc="wait.formatted_waiting_time"/> mins
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
