<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Treatment Plan Views -->
    <record id="view_dental_treatment_plan_form" model="ir.ui.view">
        <field name="name">dental.treatment.plan.form</field>
        <field name="model">dental.treatment.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,proposed,approved,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="case_id"/>
                            <field name="doctor_id"/>
                            <field name="appointment_id"/>
                        </group>
                        <group>
                            <field name="plan_date"/>
                            <field name="branch_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Treatments">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="treatment_id"/>
                                    <field name="tooth_reference"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="discount"/>
                                    <field name="estimated_amount" sum="Total"/>
                                    <field name="number_of_visits"/>
                                    <field name="state"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="treatment_id"/>
                                            <field name="tooth_reference"/>
                                            <field name="description"/>
                                        </group>
                                        <group>
                                            <field name="quantity"/>
                                            <field name="unit_price"/>
                                            <field name="discount"/>
                                            <field name="estimated_amount"/>
                                            <field name="number_of_visits"/>
                                            <field name="state"/>
                                            <field name="currency_id" invisible="1"/>
                                        </group>
                                    </group>
                                    <notebook>
                                        <page string="Notes">
                                            <field name="notes"/>
                                        </page>
                                    </notebook>
                                </form>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="estimated_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                            <div class="oe_clear"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dental_treatment_plan_list" model="ir.ui.view">
        <field name="name">dental.treatment.plan.list</field>
        <field name="model">dental.treatment.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="plan_date"/>
                <field name="doctor_id"/>
                <field name="estimated_total"/>
                <field name="state"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_dental_treatment_plan" model="ir.actions.act_window">
        <field name="name">Treatment Plans</field>
        <field name="res_model">dental.treatment.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Treatment Session Views -->
    <record id="view_dental_treatment_session_form" model="ir.ui.view">
        <field name="name">dental.treatment.session.form</field>
        <field name="model">dental.treatment.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="planned,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_line_id"/>
                            <field name="plan_id"/>
                            <field name="case_id"/>
                            <field name="patient_id"/>
                        </group>
                        <group>
                            <field name="session_date"/>
                            <field name="doctor_id"/>
                            <field name="appointment_id"/>
                            <field name="tooth_reference"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Procedure Notes">
                            <field name="procedure_notes"/>
                        </page>
                        <page string="Clinical Notes">
                            <field name="clinical_notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dental_treatment_session_list" model="ir.ui.view">
        <field name="name">dental.treatment.session.list</field>
        <field name="model">dental.treatment.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="session_date"/>
                <field name="doctor_id"/>
                <field name="plan_line_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_dental_treatment_session" model="ir.actions.act_window">
        <field name="name">Treatment Sessions</field>
        <field name="res_model">dental.treatment.session</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
