<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_appointment_form_inherit_core" model="ir.ui.view">
        <field name="name">dental.appointment.form.inherit.core</field>
        <field name="model">dental.appointment</field>
        <field name="inherit_id" ref="dental_appointment.view_dental_appointment_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_clinical_case" type="object" class="oe_stat_button" icon="fa-stethoscope" invisible="state not in ('in_consultation', 'completed')">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="case_count" nolabel="1"/>
                        </span>
                        <span class="o_stat_text">Clinical Case</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
