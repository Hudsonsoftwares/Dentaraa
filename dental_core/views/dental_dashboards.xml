<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- RECEPTIONIST WORKFLOW -->
    <menuitem id="menu_dental_reception_desk"
              name="Reception Desk"
              parent="dental_base.menu_dental_root"
              sequence="5"
              groups="dental_base.group_dental_receptionist,dental_base.group_dental_manager,dental_base.group_dental_admin"/>

    <!-- Actions for Receptionist -->
    <record id="action_reception_todays_appointments" model="ir.actions.act_window">
        <field name="name">Today's Appointments</field>
        <field name="res_model">dental.appointment</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="domain">[('date_start', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('date_start', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]</field>
    </record>

    <record id="action_reception_checked_in" model="ir.actions.act_window">
        <field name="name">Checked-in &amp; Waiting</field>
        <field name="res_model">dental.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('checked_in', 'in_consultation'))]</field>
        <field name="view_id" ref="dental_appointment.view_dental_appointment_queue_tree"/>
    </record>

    <record id="action_reception_patients" model="ir.actions.act_window">
        <field name="name">Patient Registration</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_dental_patient', '=', True)]</field>
        <field name="context">{'default_is_dental_patient': True}</field>
    </record>

    <record id="action_reception_professional_dashboard" model="ir.actions.client">
        <field name="name">Reception Desk</field>
        <field name="tag">dental_core.receptionist_dashboard</field>
    </record>

    <!-- Reception Menus -->
    <menuitem id="menu_reception_overview" name="Overview" parent="menu_dental_reception_desk" action="action_reception_professional_dashboard" sequence="5"/>


    <!-- DENTIST WORKFLOW -->
    <menuitem id="menu_dental_dentist_workspace"
              name="My Workspace"
              parent="dental_base.menu_dental_root"
              sequence="6"
              groups="dental_base.group_dental_dentist,dental_base.group_dental_manager,dental_base.group_dental_admin"/>

    <!-- Actions for Dentist Workspace -->
    <record id="action_dentist_workspace_todays_appointments" model="ir.actions.act_window">
        <field name="name">Today's Appointments</field>
        <field name="res_model">dental.appointment</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="domain">[('doctor_id.user_id', '=', uid), ('date_start', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('date_start', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]</field>
    </record>

    <record id="action_dentist_workspace_queue" model="ir.actions.act_window">
        <field name="name">Waiting Queue</field>
        <field name="res_model">dental.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('checked_in', 'in_consultation')), ('doctor_id.user_id', '=', uid)]</field>
        <field name="view_id" ref="dental_appointment.view_dental_appointment_queue_tree"/>
    </record>
    
    <record id="action_dentist_workspace_upcoming_patients" model="ir.actions.act_window">
        <field name="name">Upcoming Patients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('appointment_ids.doctor_id.user_id', '=', uid), ('appointment_ids.state', 'in', ('pending', 'confirmed')), ('appointment_ids.date_start', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]</field>
    </record>

    <record id="action_dentist_workspace_active_cases" model="ir.actions.act_window">
        <field name="name">Active Dental Cases</field>
        <field name="res_model">dental.case</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('doctor_id.user_id', '=', uid), ('state', 'in', ('draft', 'open', 'under_treatment'))]</field>
    </record>
    
    <record id="action_dentist_workspace_pending_sessions" model="ir.actions.act_window">
        <field name="name">Pending Treatment Sessions</field>
        <field name="res_model">dental.treatment.session</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('doctor_id.user_id', '=', uid), ('state', 'in', ('planned', 'in_progress'))]</field>
    </record>

    <record id="action_dentist_professional_dashboard" model="ir.actions.client">
        <field name="name">Overview</field>
        <field name="tag">dental_core.dentist_dashboard</field>
    </record>

    <!-- Dentist Workspace Menus -->
    <menuitem id="menu_dentist_ws_overview" name="Overview" parent="menu_dental_dentist_workspace" action="action_dentist_professional_dashboard" sequence="5"/>
    <menuitem id="menu_dentist_ws_todays_appointments" name="Today's Appointments" parent="menu_dental_dentist_workspace" action="action_dentist_workspace_todays_appointments" sequence="10"/>
    <menuitem id="menu_dentist_ws_queue" name="Waiting Queue" parent="menu_dental_dentist_workspace" action="action_dentist_workspace_queue" sequence="20"/>
    <menuitem id="menu_dentist_ws_upcoming_patients" name="Upcoming Patients" parent="menu_dental_dentist_workspace" action="action_dentist_workspace_upcoming_patients" sequence="30"/>
    <menuitem id="menu_dentist_ws_active_cases" name="Active Dental Cases" parent="menu_dental_dentist_workspace" action="action_dentist_workspace_active_cases" sequence="40"/>
    <menuitem id="menu_dentist_ws_pending_sessions" name="Pending Treatment Sessions" parent="menu_dental_dentist_workspace" action="action_dentist_workspace_pending_sessions" sequence="50"/>

</odoo>

