<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dental_treatment_plan" model="ir.sequence">
            <field name="name">Dental Treatment Plan</field>
            <field name="code">dental.treatment.plan</field>
            <field name="prefix">PLAN/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <record id="seq_dental_clinical_examination" model="ir.sequence">
            <field name="name">Clinical Examination</field>
            <field name="code">dental.clinical.examination</field>
            <field name="prefix">EXAM/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_dental_treatment_session" model="ir.sequence">
            <field name="name">Treatment Session</field>
            <field name="code">dental.treatment.session</field>
            <field name="prefix">SESS/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
