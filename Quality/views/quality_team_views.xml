<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_quality_team_list" model="ir.ui.view">
        <field name="name">quality.team.list</field>
        <field name="model">quality.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="alias_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_quality_team_form" model="ir.ui.view">
        <field name="name">quality.team.form</field>
        <field name="model">quality.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_checks" type="object"
                                class="oe_stat_button" icon="fa-check-square-o">
                            <field name="check_count" widget="statinfo" string="Checks"/>
                        </button>
                        <button name="action_view_alerts" type="object"
                                class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="alert_count" widget="statinfo" string="Alerts"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Team Name"/>
                        <h1><field name="name" placeholder="e.g. The QA Masters"/></h1>
                    </div>
                    <group>
                        <group name="alias_def">
                            <field name="alias_id" invisible="1"/>
                            <label for="alias_name" string="Email Alias"/>
                            <div class="d-inline-flex">
                                <field name="alias_name" placeholder="alias"/>@
                                <field name="alias_domain_id" placeholder="e.g. domain.com" options="{'no_create': True, 'no_open': True}"/>
                            </div>
                            <field name="alias_contact" string="Accept Emails From"/>
                        </group>
                        <group name="right">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_quality_team" model="ir.actions.act_window">
        <field name="name">Quality Teams</field>
        <field name="res_model">quality.team</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Quality Team</p>
            <p>Group quality checks and alerts by responsible team, e.g. Incoming
               Inspection, Production Quality, Final Inspection.</p>
        </field>
    </record>
    <record id="view_quality_team_kanban" model="ir.ui.view">
        <field name="name">quality.team.kanban</field>
        <field name="model">quality.team</field>
        <field name="arch" type="xml">
            <kanban highlight_color="color" class="o_kanban_dashboard" create="false">
                <field name="name"/>
                <field name="check_count"/>
                <field name="alert_count"/>
                <field name="color"/>
                <field name="alias_id"/>
                <templates>
                    <t t-name="menu">
                        <div class="container">
                            <div class="row">
                                <div class="col-12" role="menuitem" aria-haspopup="true">
                                    <field name="color" widget="kanban_color_picker"/>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="card">
                        <div class="p-2">
                            <div class="mb-4">
                                <span class="fw-bold fs-5"><field name="name"/></span>
                                <div t-if="record.alias_id.value" class="text-muted mt-1 small">
                                    <i class="fa fa-envelope-o me-1"/>
                                    <field name="alias_id"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <button class="btn btn-primary btn-sm" name="action_view_alerts" type="object">
                                        <t t-out="record.alert_count.value"/> Quality Alerts
                                    </button>
                                </div>
                                <div class="col-6 d-flex align-items-center">
                                    <a name="action_view_checks" type="object" t-if="record.check_count.raw_value > 0" class="text-success">
                                        <t t-out="record.check_count.value"/> Checks In Progress
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_quality_team_overview" model="ir.actions.act_window">
        <field name="name">Quality Overview</field>
        <field name="res_model">quality.team</field>
        <field name="view_mode">kanban,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            No quality team found
          </p>
        </field>
    </record>

</odoo>
