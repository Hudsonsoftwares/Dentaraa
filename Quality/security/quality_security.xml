<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_quality_custom">
        <field name="name">Quality</field>
        <field name="description">Manage quality control points, checks, and alerts.</field>
        <field name="sequence">14</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_quality">
        <field name="name">Quality</field>
        <field name="sequence">14</field>
        <field name="category_id" ref="module_category_quality_custom"/>
    </record>

    <record id="group_quality_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_quality"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_quality_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_quality"/>
        <field name="implied_ids" eval="[(4, ref('group_quality_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
