<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Company Form View -->
    <record id="view_company_form_dental" model="ir.ui.view">
        <field name="name">res.company.form.dental</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <field name="is_dental_clinic" invisible="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Dental Clinic Setup" name="dental_clinic" invisible="not is_dental_clinic">
                    <group>
                        <group string="Operating Timings">
                            <field name="working_days"/>
                            <field name="opening_time" widget="float_time"/>
                            <field name="closing_time" widget="float_time"/>
                        </group>
                        <group string="Clinic Details">
                            <field name="clinic_manager_id"/>
                            <field name="clinic_registration_number"/>
                        </group>
                    </group>
                    <group string="Letterhead &amp; Branding">
                        <field name="letterhead_header"/>
                        <field name="letterhead_footer"/>
                    </group>
                    <group string="Internal Notes">
                        <field name="clinic_notes" nolabel="1" placeholder="Clinic specific policies..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
