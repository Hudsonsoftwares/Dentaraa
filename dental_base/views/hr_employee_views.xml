<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Employee Form View to add Dental Profile -->
    <record id="view_employee_form_inherit_dental" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.dental</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Dental Clinic Profile" name="dental_profile">
                    <group>
                        <group string="Dental Roles &amp; Branch">
                            <field name="dental_role"/>
                            <field name="is_dentist" invisible="1"/>
                        </group>
                        <group string="Doctor Credentials" invisible="dental_role != 'dentist'">
                            <field name="registration_number"/>
                            <field name="specialization"/>
                            <field name="consultation_fee"/>
                        </group>
                    </group>
                    <group string="Digital Signatures &amp; Stamps" invisible="dental_role != 'dentist'">
                        <group>
                            <field name="signature_image" widget="image" options="{'size': [160, 80]}"/>
                        </group>
                        <group>
                            <field name="digital_stamp" widget="image" options="{'size': [160, 160]}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Inherit Employee Search View to add Dental Filters -->
    <record id="view_employee_filter_inherit_dental" model="ir.ui.view">
        <field name="name">hr.employee.search.inherit.dental</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='group_job']" position="after">
                <filter string="Dental Role" name="group_dental_role" domain="[]" context="{'group_by': 'dental_role'}"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Dentists &amp; Doctors" name="filter_dentists" domain="[('dental_role', '=', 'dentist')]"/>
                <filter string="Dental Staff" name="filter_dental_staff" domain="[('dental_role', '!=', False)]"/>
            </xpath>
        </field>
    </record>

    <!-- Action for Dental Staff & Doctors -->
    <record id="action_dental_staff" model="ir.actions.act_window">
        <field name="name">Staff &amp; Doctors</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('dental_role', '!=', False)]</field>
        <field name="context">{'search_default_filter_dental_staff': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add staff members and doctors for your dental clinic!
            </p>
            <p>
                Manage dentists, assistants, receptionists, lab technicians, and pharmacists with roles and branches.
            </p>
        </field>
    </record>
</odoo>
